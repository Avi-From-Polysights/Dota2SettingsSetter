<Window x:Class="Dota2SettingsSetter.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <Border Padding="24,20" Width="420">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBox x:Name="Input" Margin="0,14,0,0" MaxLength="40" TextChanged="Input_TextChanged" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="84"
                        Margin="0,0,8,0" Click="Ok_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="84" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
