<Window x:Class="Dota2SettingsSetter.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <Border Padding="24,20" MaxWidth="520" MinWidth="380">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19" />
            <WrapPanel x:Name="ButtonPanel" HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </Border>
</Window>
